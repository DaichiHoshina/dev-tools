# Claude Code のセッションデータを置いている dir
CLAUDE_DIR=~/.claude/projects

# バックエンドの待ち受け設定
# /ws/terminal は認証なしでシェルを起動するため、HOST はループバックのままにする
HOST=127.0.0.1
PORT=3010

# Jira 連携 (チケットキーからタイトルを引く)。使わない場合は空のままでよい
ATLASSIAN_SITE_NAME=your-org
JIRA_BASE_URL=https://your-org.atlassian.net
ATLASSIAN_USER_EMAIL=
ATLASSIAN_API_TOKEN=
